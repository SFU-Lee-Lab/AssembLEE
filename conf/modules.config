process {

    withName: QUAST {
        ext.args = { '--no-plots \
            --no-html \
            --no-icarus \
            --no-snps \
            --no-sv' 
        }
    }

    withName: SEQFU_SHRED {
        ext.args = { "-l 1000 -x 1 --fasta" }
        ext.prefix = { "${meta.id}_shredded" }
    }

    withName: AUTOCYCLER_SUBSAMPLE {
        ext.args = '-d 45 -c 4'
    }

    withName: MINIASM {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/MINIASM/${meta.id}" },
            mode: "copy",
            pattern: "*.gfa.gz"
        ]
    }

    withName: MINIPOLISH {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/MINIASM/${meta.id}" },
            mode: "copy"
        ]
        ext.prefix = { "${meta.id}_miniasm" }
        errorStrategy = 'ignore'
    }
    
    withName: RAVEN {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/RAVEN/${meta.id}" },
            mode: "copy"
        ]
        ext.prefix = { "${meta.id}_raven" }
        errorStrategy = 'ignore'
    }

    withName: FLYE {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/FLYE/${meta.id}" },
            mode: "copy"
        ]
        errorStrategy = 'ignore'
    }

    withName: FLYE_SUBSAMPLE {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/FLYE/${meta.id}" },
            mode: "copy"
        ]
        ext.prefix = { "${meta.id}_flye" }
    }

    withName: AUTOCYCLER_COMPRESS {
        ext.args = "--max_contigs 500"
    }

    withName: AUTOCYCLER_CLUSTER {
        ext.prefix = { "${meta.id}_${meta.cluster}" }
    }

    withName: AUTOCYCLER_TRIM {
        ext.prefix = { "${meta.id}_${meta.cluster}" }
    }

    withName: AUTOCYCLER_RESOLVE {
        ext.prefix = { "${meta.id}_${meta.cluster}" }
    }

    withName: AUTOCYCLER_COMBINE {
        publishDir = [
            path: { "${params.out_dir}/ASSEMBLY/RAW/CONSENSUS/${meta.id}" },
            mode: "copy"
        ]
    }

    withName: GUNC_RUN {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_QC/GUNC/${meta.id}" },
                mode: "copy"
        ]
        ext.args = '--detailed_output --contig_taxonomy_output'
    }

    withName: CHECKM {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_QC/CHECKM/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: 'POST_ASM_PROCESS:ASSEMBLY_QC:QUAST' {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_QC/QUAST/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: BAKTA_BAKTA {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_ANNOT/BAKTA/${meta.id}" },
                mode: "copy"
        ]
        ext.args = '--skip-plot'
    }

    withName: SOURMASH_SKETCH {
        ext.args = 'dna'
    }

    withName: 'POST_ASM_PROCESS:ASSEMBLY_QC:SOURMASH_GATHER' {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_QC/SOURMASH/${meta.id}" },
                mode: "copy"
        ]
        ext.args = '-k 31 --scaled 1000 --threshold-bp 5000'
    }

    withName: MINIMAP2_PAIRED_ALIGN {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_COVERAGE/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: MINIMAP2_ALIGN_PAF {
        ext.args = { "-x ava-ont" }
    }

    withName: MEDAKA {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY/POLISHED/${meta.id}" },
                mode: "copy"
        ]
        ext.args = { "--bacteria -m $params.medaka_model" }
    }

    withName: SAMTOOLS_FAIDX {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_COVERAGE/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: CENTRIFUGER_CENTRIFUGER {
        publishDir = [
                path: { "${params.out_dir}/TAXONOMIC_CLASSIFICATION/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: CENTRIFUGER_QUANTIFICATION {
        publishDir = [
                path: { "${params.out_dir}/TAXONOMIC_CLASSIFICATION/${meta.id}" },
                mode: "copy"
        ]
        ext.prefix = { "${meta.id}_kreport" }
        ext.args = "--output-format 3"
    }

    withName: KRONA_KTUPDATETAXONOMY {
        label = 'process_low'
    }

    withName: KRONA_KTIMPORTTAXONOMY {
        label = 'process_medium'
        publishDir = [
                path: { "${params.out_dir}/TAXONOMIC_CLASSIFICATION/${meta.id}" },
                mode: "copy"
        ]
    }
     
    withName: KRONA_KTIMPORTKRONA {
        publishDir = [
                path: { "${params.out_dir}/REPORTS/" },
                mode: "copy"
        ]
        ext.prefix = "krona_taxonomy_profile"
    }

    withName: CHECKM_TAXONOMYWF {
        publishDir = [
                path: { "${params.out_dir}/ASSEMBLY_QC/CHECKM/${meta.id}" },
                mode: "copy"
        ]
    }

    withName: NANOQ_PREFILTER {
        publishDir = [
                path: { "${params.out_dir}/READS_QC/NANOQ/${meta.id}" },
                mode: "copy",
                pattern: "*.stats"
        ]
        ext.args = "-s -H"
        ext.prefix = { "${meta.id}_prefiltered" }
    }

    withName: NANOQ {
        publishDir = [
                path: { "${params.out_dir}/READS_QC/NANOQ/${meta.id}" },
                mode: "copy"
        ]
        ext.args = { "-H -q ${params.min_rq} -l ${params.min_rl}" }
    }
}

    
